{
  "name": "comp4020-final",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "node scripts/dev.ts",
    "dev:client": "vite",
    "build": "pnpm check:uplink && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm check:native && pnpm test:unit && pnpm test",
    "check:uplink": "node scripts/check-uplink-bundle.ts",
    "gen:native": "node scripts/native/generate-tables.ts",
    "check:native": "node scripts/native/generate-tables.ts --check && pnpm check:native-world && pnpm check:race-cargo && pnpm check:race-machinery && pnpm check:environmental",
    "check:evidence": "node scripts/check-evidence.ts",
    "check:browser": "node scripts/browser-check.ts",
    "check:multiplayer": "node scripts/multiplayer-browser-check.ts",
    "sync:bundle": "node scripts/sync-bundle.ts",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "start": "node server/app.ts",
    "dev:server": "DATA_DIR=.local-data node server/app.ts",
    "check:crossfeed": "node scripts/crossfeed-browser-check.ts",
    "check:heroes": "node scripts/hero-browser-check.ts",
    "check:receivers": "node scripts/receiver-browser-check.ts",
    "check:multiplayer-pairing": "node scripts/multiplayer-browser-check.ts",
    "check:multiplayer-relay": "node scripts/labs-browser-check.ts relay-lab",
    "check:multiplayer-lift": "node scripts/labs-browser-check.ts lift-lab",
    "check:multiplayer-crumble": "node scripts/labs-browser-check.ts crumble-lab",
    "check:multiplayer-boost": "node scripts/labs-browser-check.ts boost-lab",
    "check:multiplayer-firewall": "node scripts/labs-browser-check.ts firewall-lab",
    "check:race": "node scripts/race-browser-check.ts",
    "check:campaign": "node scripts/campaign-browser-check.ts",
    "check:observability": "node scripts/observability-browser-check.ts",
    "check:character": "node scripts/character-browser-check.ts",
    "check:checkpoints": "node scripts/checkpoint-browser-check.ts",
    "workbench": "node scripts/level-tools/workbench.ts",
    "level:new": "node scripts/level-tools/cli.ts new",
    "level:import": "node scripts/level-tools/cli.ts import",
    "level:validate": "node scripts/level-tools/cli.ts validate",
    "level:render": "node scripts/level-tools/cli.ts render",
    "level:playtest": "node scripts/level-tools/cli.ts playtest",
    "check:workbench": "node scripts/level-tools/browser-check.ts",
    "check:public-builder": "node scripts/level-tools/public-browser-check.ts",
    "check:workbench-menu": "node scripts/level-tools/menu-browser-check.ts",
    "check:public-coop": "node scripts/level-tools/public-coop-browser-check.ts",
    "check:native-evidence": "node scripts/native-evidence-browser-check.ts",
    "gen:native-world": "node scripts/native/world-evidence.ts",
    "check:native-world": "node scripts/native/world-evidence.ts --check",
    "check:world-assembly": "node scripts/native-world-browser-check.ts",
    "gen:race-machinery": "node scripts/native/race-machinery-evidence.ts",
    "check:race-machinery": "node scripts/native/race-machinery-evidence.ts --check",
    "check:race-machinery-browser": "node scripts/race-machinery-browser-check.ts",
    "gen:race-cargo": "node scripts/native/race-cargo-evidence.ts",
    "check:race-cargo": "node scripts/native/race-cargo-evidence.ts --check",
    "check:race-cargo-browser": "node scripts/race-cargo-browser-check.ts",
    "gen:environmental": "node scripts/native/environmental-evidence.ts",
    "check:environmental": "node scripts/native/environmental-evidence.ts --check"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "8.18.2",
    "jsdom": "^30.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
