{
  "name": "comp4020-final",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "node scripts/dev.ts",
    "dev:client": "vite",
    "build": "pnpm check:uplink && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test:unit && pnpm test",
    "check:uplink": "node scripts/check-uplink-bundle.ts",
    "check:evidence": "node scripts/check-evidence.ts",
    "check:browser": "node scripts/browser-check.ts",
    "check:multiplayer": "node scripts/multiplayer-browser-check.ts",
    "sync:bundle": "node scripts/sync-bundle.ts",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "start": "node server/app.ts",
    "dev:server": "DATA_DIR=.local-data node server/app.ts",
    "check:crossfeed": "node scripts/crossfeed-browser-check.ts",
    "check:multiplayer-pairing": "node scripts/multiplayer-browser-check.ts",
    "check:multiplayer-relay": "node scripts/labs-browser-check.ts relay-lab",
    "check:multiplayer-lift": "node scripts/labs-browser-check.ts lift-lab",
    "check:multiplayer-crumble": "node scripts/labs-browser-check.ts crumble-lab",
    "check:multiplayer-boost": "node scripts/labs-browser-check.ts boost-lab",
    "check:multiplayer-firewall": "node scripts/labs-browser-check.ts firewall-lab"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "8.18.2",
    "jsdom": "^30.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
