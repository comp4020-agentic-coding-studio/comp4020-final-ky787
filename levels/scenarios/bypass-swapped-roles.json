    },
    {
      "label": "OVERRIDE survives death and checkpoint retry",
      "actions": [
        {
          "type": "tap",
          "actor": "p1",
          "code": "KeyR"
        }
      ],
      "waitMs": 250,
      "assert": [
        {
          "actor": "p1",
          "condition": {
            "path": "player.deaths",
            "equals": 3
          }
        },
        {
          "actor": "p1",
          "condition": {
            "path": "controls.draft:link",
            "equals": true
          }
        },
        {
          "actor": "p1",
          "condition": {
            "path": "controls.draft:override",
            "equals": true
          }
        },
        {
          "actor": "p1",
          "condition": {
            "path": "signals.draft:firewallActive",
            "equals": false
          }
        }
      ]
    },
    {
      "label": "First crumble contact / takeoff",
      "actions": [
        {
          "type": "walk",
          "actor": "p1",
          "x": 2050
        }
      ],
      "waitMs": 220
    },
    {
      "label": "First crumble contact / tap ordinary jump",
      "actions": [
        {
          "type": "key",
          "actor": "p1",
          "code": "KeyD",
          "down": true
        },
        {
          "type": "tap",
          "actor": "p1",
          "code": "Space"
        }
      ],
      "wait": {
        "actor": "p1",
        "condition": {
          "path": "player.x",
          "min": 2280
