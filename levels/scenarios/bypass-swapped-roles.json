      "assert": [
        {
          "actor": "p1",
          "condition": {
            "path": "player.x",
            "min": 1345,
            "max": 1355
          }
        },
        {
          "actor": "p2",
          "condition": {
            "path": "player.groundId",
            "equals": "middleBank"
          }
        },
        {
          "actor": "p1",
          "condition": {
            "path": "controls.draft:override",
            "equals": true
          }
        }
      ]
    },
    {
      "label": "Wait for shared platform recovery",
