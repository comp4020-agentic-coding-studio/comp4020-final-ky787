{
  "version": 1,
  "id": "bypass-swapped-roles",
  "scope": "full-room",
  "mode": "coop",
  "timeoutMs": 180000,
  "actors": [
    {
      "id": "p1",
      "slot": 2
    },
    {
      "id": "p2",
      "slot": 1
    }
  ],
  "steps": [
    {
      "label": "Portal is accepted open before any input or commitment",
      "wait": {
        "actor": "p1",
        "condition": {
          "path": "exitUnlocked",
          "equals": true
        },
        "timeoutMs": 5000
      },
      "assert": [
        {
          "actor": "p1",
          "condition": {
            "path": "exitUnlocked",
            "equals": true
          }
        },
        {
          "actor": "p1",
          "condition": {
            "path": "signals.draft:exitReady",
            "equals": true
          }
        },
        {
          "actor": "p1",
          "condition": {
            "path": "controls.draft:link",
            "equals": false
          }
        },
        {
          "actor": "p1",
          "condition": {
            "path": "controls.draft:override",
            "equals": false
          }
        },
        {
          "actor": "p1",
          "condition": {
            "path": "completed",
            "equals": false
          }
        },
        {
          "actor": "p2",
          "condition": {
            "path": "exitUnlocked",
            "equals": true
          }
        },
        {
          "actor": "p2",
          "condition": {
            "path": "signals.draft:exitReady",
            "equals": true
          }
        },
        {
          "actor": "p2",
          "condition": {
            "path": "controls.draft:link",
            "equals": false
          }
        },
        {
          "actor": "p2",
          "condition": {
            "path": "controls.draft:override",
            "equals": false
          }
        },
        {
          "actor": "p2",
          "condition": {
            "path": "completed",
            "equals": false
          }
        }
      ]
    },
    {
      "label": "P1 holds the anchor scanner",
      "actions": [
        {
          "type": "walk",
          "actor": "p1",
          "x": 270
        }
      ],
      "waitMs": 220,
      "assert": [
        {
          "actor": "p2",
          "condition": {
            "path": "signals.draft:anchorPower",
            "equals": true
          }
        },
        {
          "actor": "p2",
          "condition": {
            "path": "controls.draft:link",
            "equals": false
          }
        }
      ]
    },
    {
      "label": "Retry opening with automatic targeting",
      "actions": [
        {
          "type": "walk",
          "actor": "p2",
          "x": 515
        }
      ],
      "waitMs": 220
    },
    {
      "label": "Tap Space to jump, then press and hold Space in air",
      "actions": [
        {
          "type": "key",
          "actor": "p2",
          "code": "KeyD",
          "down": true
        },
        {
          "type": "tap",
          "actor": "p2",
          "code": "Space"
        }
      ],
      "waitMs": 25
    },
    {
      "label": "Automatic Space hook really attaches",
      "actions": [
        {
          "type": "key",
          "actor": "p2",
          "code": "Space",
          "down": true
        }
      ],
      "wait": {
        "actor": "p2",
        "condition": {
          "path": "player.rope.phase",
          "equals": "attached"
        },
        "timeoutMs": 5000
      },
      "assert": [
        {
          "actor": "p2",
          "condition": {
            "path": "player.rope.anchorId",
            "equals": "anchor"
          }
        }
      ]
    },
    {
      "label": "Hold D and Space to swing over the gap",
      "wait": {
        "actor": "p2",
        "condition": {
          "path": "player.x",
          "min": 960
        },
        "timeoutMs": 5000
      },
      "assert": [
        {
          "actor": "p2",
          "condition": {
            "path": "player.rope.phase",
            "equals": "attached"
          }
        },
        {
          "actor": "p2",
          "condition": {
            "path": "player.deaths",
            "equals": 0
          }
        }
      ]
    },
    {
      "label": "Release Space to perform the rope jump",
      "actions": [
        {
          "type": "key",
          "actor": "p2",
          "code": "Space",
          "down": false
        }
      ],
      "wait": {
        "actor": "p2",
        "condition": {
          "path": "player.groundId",
          "equals": "middleBank"
        },
        "timeoutMs": 5000
      }
    },
    {
      "label": "Stop on the broad permanent landing",
      "actions": [
        {
          "type": "key",
          "actor": "p2",
          "code": "KeyD",
          "down": false
        }
      ],
      "waitMs": 200
    },
    {
      "label": "Approach LINK on safe ground",
      "actions": [
        {
          "type": "walk",
          "actor": "p2",
          "x": 1100
        }
      ],
      "waitMs": 220
    },
    {
      "label": "Commit LINK",
      "actions": [
        {
          "type": "tap",
          "actor": "p2",
          "code": "KeyE"
        }
      ],
      "wait": {
        "actor": "p1",
        "condition": {
          "path": "signals.draft:bridgePower",
          "equals": true
        },
        "timeoutMs": 5000
      }
    },
    {
      "label": "LINK survives an ordinary reset",
      "actions": [
        {
          "type": "tap",
          "actor": "p2",
          "code": "KeyR"
        }
      ],
      "waitMs": 250,
      "assert": [
        {
          "actor": "p2",
          "condition": {
            "path": "controls.draft:link",
            "equals": true
          }
        },
        {
          "actor": "p2",
          "condition": {
            "path": "player.deaths",
            "equals": 1
          }
        },
        {
          "actor": "p2",
          "condition": {
            "path": "player.groundId",
            "equals": "middleBank"
          }
        }
      ]
    },
    {
      "label": "P1 leaves HOLD and stands on the latched bridge",
      "actions": [
        {
          "type": "walk",
          "actor": "p1",
          "x": 770
        }
      ],
      "waitMs": 220,
      "assert": [
        {
          "actor": "p1",
          "condition": {
            "path": "player.groundId",
            "equals": "bridge"
          }
        },
        {
          "actor": "p1",
          "condition": {
            "path": "plates.draft:anchorHold",
            "equals": false
          }
        }
      ]
    },
    {
      "label": "P1 can leave HOLD and walk across",
      "actions": [
        {
          "type": "walk",
          "actor": "p1",
          "x": 1260
        }
      ],
      "waitMs": 220
    },
    {
      "label": "Automatic breakpoint is accepted for both",
      "wait": {
        "actor": "p2",
        "condition": {
          "path": "session.room.checkpoint",
          "equals": "reunion"
        },
        "timeoutMs": 5000
      }
    },
    {
      "label": "Both reset to safe slot-specific checkpoint markers",
      "actions": [
        {
          "type": "tap",
          "actor": "p1",
          "code": "KeyR"
        },
        {
          "type": "tap",
          "actor": "p2",
          "code": "KeyR"
        }
      ],
      "waitMs": 300,
      "assert": [
        {
          "actor": "p1",
          "condition": {
            "path": "player.x",
            "min": 1345,
            "max": 1355
          }
        },
        {
          "actor": "p2",
          "condition": {
            "path": "player.x",
            "min": 1215,
            "max": 1225
          }
        },
        {
          "actor": "p1",
          "condition": {
            "path": "player.groundId",
            "equals": "middleBank"
          }
        },
        {
          "actor": "p2",
          "condition": {
            "path": "player.groundId",
            "equals": "middleBank"
          }
        },
        {
          "actor": "p1",
          "condition": {
            "path": "plates.draft:bypassHold",
            "equals": false
          }
        }
      ]
    },
    {
      "label": "Swap roles: P2 holds BYPASS",
      "actions": [
        {
          "type": "walk",
          "actor": "p2",
          "x": 1460
        }
      ],
      "waitMs": 220,
      "assert": [
        {
          "actor": "p1",
          "condition": {
            "path": "signals.draft:barrierA",
            "equals": false
          }
        },
        {
          "actor": "p1",
          "condition": {
            "path": "signals.draft:barrierB",
            "equals": false
          }
        }
      ]
    },
    {
      "label": "P1 walks between the disabled barriers",
      "actions": [
        {
          "type": "walk",
          "actor": "p1",
          "x": 1650
        }
      ],
      "waitMs": 220
    },
    {
      "label": "Early release restores BOTH barriers",
      "actions": [
        {
          "type": "walk",
          "actor": "p2",
          "x": 1390
        }
      ],
      "waitMs": 220,
      "assert": [
        {
          "actor": "p1",
          "condition": {
            "path": "signals.draft:barrierA",
            "equals": true
