        {
          "actor": "operator",
          "condition": {
            "path": "signals.draft:shaftFirewall",
            "equals": true
          }
        }
      ],
      "waitMs": 200,
      "capture": "stage-01-initial"
    },
    {
      "label": "Carrier approaches B",
      "actions": [
        {
          "type": "walk",
          "actor": "carrier",
          "x": 1705
        }
      ],
      "waitMs": 180
    },
    {
      "label": "Carrier picks up B",
      "actions": [
        {
          "type": "tap",
          "actor": "carrier",
          "code": "KeyE"
        }
      ],
      "wait": {
        "actor": "carrier",
        "condition": {
          "path": "session.sharedCubes.draft:cubeB.holder",
